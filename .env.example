



# --- Supabase (https://supabase.com/dashboard -> Paramètres -> API) ---
URL_SUPABASE_PUBLIC_SUPPLÉMENTAIRE=
SUIVANT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : UNIQUEMENT côté serveur (webhooks Stripe). Ne JAMAIS l'exposer.
